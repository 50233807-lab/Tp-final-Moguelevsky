@{
    ViewData["Title"] = "Registro - RentaYa";
}

<section class="contenedor-auth">
    <div class="caja-auth">
        <h1>RentaYa</h1>
        <h2>Crear Cuenta</h2>

        @if (ViewBag.Error != null)
        {
            <p class="mensaje-error">@ViewBag.Error</p>
        }

        <p id="mensajeError" class="mensaje-error"></p>

        <form action='@Url.Action("Registro", "Account")' method="POST" onsubmit="return validarRegistro()">
            <div class="campo-form">
                <label for="nombreUsuario">Nombre de usuario</label>
                <input type="text" id="nombreUsuario" name="nombreUsuario" placeholder="Elegí un usuario" />
            </div>

            <div class="campo-form">
                <label for="contrasena">Contraseña</label>
                <input type="password" id="contrasena" name="contrasena" placeholder="Mínimo 8 caracteres y 1 especial" />
            </div>

            <div class="campo-form">
                <label for="nombre">Nombre</label>
                <input type="text" id="nombre" name="nombre" placeholder="Tu nombre" />
            </div>

            <div class="campo-form">
                <label for="apellido">Apellido</label>
                <input type="text" id="apellido" name="apellido" placeholder="Tu apellido" />
            </div>

            <button type="submit" class="btn-principal">Registrarse</button>
        </form>

        <p>¿Ya tenés cuenta? <a href='@Url.Action("Login", "Account")'>Iniciá sesión acá</a></p>
    </div>
</section>
